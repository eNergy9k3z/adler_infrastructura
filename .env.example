# Server-only settings. Enter the real key in Vercel Environment Variables.
# Never prefix an AI key with VITE_ or commit a real value.
OPENROUTER_API_KEY=
ADLER_CHAT_AI_ENABLED=false
ADLER_CHAT_ORIGIN=https://adler-infrastructura.vercel.app

# Enable only after signup, custom SMTP and both client redirects are verified.
# This is a public UI setting; account verification remains enforced by Supabase.
VITE_CLIENT_REGISTRATION_ENABLED=false
